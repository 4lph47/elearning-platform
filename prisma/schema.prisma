datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Connection pool configuration
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum ResourceType {
  PDF
  IMAGE
  VIDEO
  OTHER
  SLIDES
}

enum QuizScope {
  LESSON
  MODULE
  COURSE
}

enum LessonType {
  VIDEO
  TEXT
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum NotificationType {
  MENTION
  RESALE_COMMISSION_CHANGE
  COMMENT_REPLY
}

model User {
  id                           String            @id @default(cuid())
  name                         String
  email                        String            @unique
  emailVerified                DateTime?
  image                        String?
  passwordHash                 String?
  role                         Role              @default(STUDENT)
  bio                          String?
  expertise                    String?
  yearsExperience              Int?
  bannerUrl                    String?
  bannerType                   String?
  websiteUrl                   String?
  twitterUrl                   String?
  linkedinUrl                  String?
  youtubeUrl                   String?
  instagramUrl                 String?
  facebookUrl                  String?
  tiktokUrl                    String?
  githubUrl                    String?
  discordUrl                   String?
  mediumUrl                    String?
  twitchUrl                    String?
  certifications               Certification[]
  // null = conta criada (Google/link mágico) mas ainda não passou pelo
  // ecrã de aceitar termos em /register/complete — o middleware tranca a
  // navegação até isto ficar preenchido. Contas por credenciais já ficam
  // com isto definido na criação, porque o formulário exige aceitar os
  // termos antes de submeter — mas para essas o gate (ver lib/auth.ts
  // "registered") também exige emailVerified, por isso não basta isto.
  termsAcceptedAt              DateTime?
  // @tag único usado nas @menções dos comentários e mostrado no perfil
  // público — escolhido no registo (credenciais) ou em /register/complete
  // (Google/link mágico, cuja conta o adapter já cria sem isto).
  username                     String?           @unique
  // Quando o username foi alterado pela última vez (null = nunca, ainda é o
  // escolhido no registo) — usado para bloquear trocas a cada 14 dias.
  usernameChangedAt            DateTime?
  phone                        String?
  birthDate                    DateTime?
  // Preferência de idioma — guardada para uso futuro, a plataforma ainda só
  // tem UI em português (ver app/settings/language).
  locale                       String            @default("pt")
  adsPersonalization           Boolean           @default(true)
  profileVisibility            ProfileVisibility @default(PUBLIC)
  searchByEmail                Boolean           @default(true)
  searchByPhone                Boolean           @default(true)
  showCommunitiesOnProfile     Boolean           @default(true)
  notifyEmail                  Boolean           @default(true)
  notifyPush                   Boolean           @default(true)
  notifySms                    Boolean           @default(false)
  // Definições > Cursos — avança sozinho pra próxima aula quando o vídeo
  // acaba (ver components/player/LessonPlayer.tsx, ecrã de fim).
  autoplayNextLesson           Boolean           @default(true)
  // Definições > Venda — sugestão pré-preenchida no formulário de criar
  // curso (Course.resaleMinCommission), nunca aplicada sozinha a cursos
  // já existentes.
  defaultResaleMinCommission   Float?
  // Definições > Aparência — aplicados no cliente por AppearanceEffects
  // (ver components/layout/AppearanceEffects.tsx) via CSS vars/atributos
  // em <html>, lidos por app/globals.css.
  accentColor                  String            @default("blue")
  fontSize                     String            @default("md")
  reduceMotion                 Boolean           @default(false)
  // Código de 6 dígitos enviado por email às contas por password — só
  // essas precisam disto (Google/link mágico já provam dono do email só
  // por completarem o respetivo fluxo).
  emailVerificationCode        String?
  emailVerificationCodeExpires DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  accounts              Account[]
  sessions              Session[]
  coursesTaught         Course[]            @relation("InstructorCourses")
  collaboratingCourses  Course[]            @relation("CourseCollaborators")
  lessonContributions   Lesson[]            @relation("LessonContributors")
  bundles               Bundle[]
  cartItems             CartItem[]
  enrollments           Enrollment[]
  lessonProgress        LessonProgress[]
  lessonNotes           LessonNote[]
  quizAttempts          QuizAttempt[]
  reviews               Review[]
  lessonComments        LessonComment[]
  commentLikes          CommentLike[]
  courseComments        CourseComment[]
  courseCommentLikes    CourseCommentLike[]
  lessonReactions       LessonReaction[]
  watchEvents           WatchEvent[]
  notificationsReceived Notification[]      @relation("NotificationRecipient")
  notificationsSent     Notification[]      @relation("NotificationActor")
  resaleListingsSold    ResaleListing[]     @relation("ResaleListingsSold")
  resaleBundlesSold     ResaleBundle[]      @relation("ResaleBundlesSold")
  resalePurchases       ResaleSale[]        @relation("ResalePurchases")
  communitiesCreated    Community[]         @relation("CommunityCreator")
  communityMemberships  CommunityMember[]   @relation("CommunityMemberships")
  communityMessages     CommunityMessage[]  @relation("CommunityMessageSender")
  blockedUsers          UserBlock[]         @relation("BlockerUser")
  blockedByUsers        UserBlock[]         @relation("BlockedUser")
}

// Lista de bloqueio de "Definições > Privacidade" — só impede pedidos futuros
// de bloqueio duplicados (@@unique) e alimenta a lista da UI; não filtra
// ainda conteúdo noutras partes da plataforma (feed, comentários, chat).
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Certification {
  id        String   @id @default(cuid())
  name      String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CartItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model Bundle {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("Outros")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  courses Course[]

  @@index([instructorId])
  @@index([category])
}

model Course {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  thumbnailUrl     String?
  trailerUrl       String?
  category         String
  level            String   @default("beginner")
  published        Boolean  @default(false)
  price            Float    @default(0)
  originalPrice    Float?
  rating           Float    @default(4.5)
  ratingCount      Int      @default(0)
  learningOutcomes String[] @default([])
  requirements     String[] @default([])
  targetAudience   String[] @default([])
  topics           String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)

  collaborators User[] @relation("CourseCollaborators")

  bundleId String?
  bundle   Bundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  // null = revenda desligada para este curso. Definido pelo próprio
  // instrutor — é o mínimo que ele exige por cada revenda; o revendedor
  // não pode listar abaixo disto (ver lib/resale.ts). Só é mostrado a quem
  // já está inscrito, nunca no catálogo público.
  resaleMinCommission Float?

  modules               Module[]
  enrollments           Enrollment[]
  cartItems             CartItem[]
  quiz                  Quiz?
  reviews               Review[]
  comments              CourseComment[]
  resaleListings        ResaleListing[]
  communityRequirements CommunityRequirement[]

  @@index([instructorId])
  @@index([published])
  @@index([bundleId])
}

// Um aluno (ou instrutor, para cursos de outros em que se inscreveu) a
// revender o acesso a um curso que já tem — não transfere/retira o acesso
// de quem vende, só concede uma nova inscrição a quem compra (ver
// ResaleSale). Preço definido pelo revendedor, nunca abaixo do
// Course.resaleMinCommission do momento em que foi criado.
model ResaleListing {
  id        String   @id @default(cuid())
  price     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerId String
  seller   User   @relation("ResaleListingsSold", fields: [sellerId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  bundles ResaleBundleListing[]
  sales   ResaleSale[]

  @@unique([sellerId, courseId])
  @@index([courseId])
}

// Agrupa listagens do mesmo vendedor — preço sempre a soma dos listings
// (mesma convenção do Bundle de instrutor, sem desconto próprio), nunca
// guardado à parte.
model ResaleBundle {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("Outros")
  description   String?
  coverImageUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sellerId String
  seller   User   @relation("ResaleBundlesSold", fields: [sellerId], references: [id], onDelete: Cascade)

  listings ResaleBundleListing[]
  sales    ResaleSale[]

  @@index([sellerId])
  @@index([category])
}

// Junção many-to-many: a mesma listagem pode entrar em vários bundles do
// mesmo vendedor (ex.: bundle A={1,2,3} e B={1,2,4}) — só não pode haver
// dois bundles do mesmo vendedor com o conjunto de listagens exatamente
// igual (validado na API, ver app/api/resale/bundles).
model ResaleBundleListing {
  id String @id @default(cuid())

  resaleBundleId String
  resaleBundle   ResaleBundle  @relation(fields: [resaleBundleId], references: [id], onDelete: Cascade)
  listingId      String
  listing        ResaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([resaleBundleId, listingId])
  @@index([listingId])
}

// Um curso vendido através de uma listagem — quer avulso quer dentro de um
// bundle (resaleBundleId preenchido só agrupa o recibo, o split é sempre
// por listing individual). instructorCut+sellerCut = price sempre.
model ResaleSale {
  id            String   @id @default(cuid())
  price         Float
  instructorCut Float
  sellerCut     Float
  createdAt     DateTime @default(now())

  listingId String
  listing   ResaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User          @relation("ResalePurchases", fields: [buyerId], references: [id], onDelete: Cascade)

  resaleBundleId String?
  resaleBundle   ResaleBundle? @relation(fields: [resaleBundleId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([buyerId])
  @@index([resaleBundleId])
}

model Module {
  id    String @id @default(cuid())
  title String
  order Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]
  quizzes Quiz[]

  @@index([courseId])
}

model Lesson {
  id              String     @id @default(cuid())
  title           String
  order           Int
  isFreePreview   Boolean    @default(false)
  type            LessonType @default(VIDEO)
  contentUrl      String?
  // Master playlist HLS (.m3u8) — atualizado pelo worker à medida que cada
  // rendition fica pronta (ver lib/videoTranscode.ts, worker/index.js). Só
  // referencia as variantes já concluídas, por isso fica reproduzível assim
  // que a 1ª existe, mesmo com o job ainda PROCESSING.
  hlsMasterUrl    String?
  thumbnailUrl    String?
  // Legendas WebVTT geradas no worker (Whisper local, onnxruntime-node) a
  // seguir à compressão do vídeo, ver worker/index.js:transcribeToVtt —
  // sobe direto pro Storage, nunca passa pelo /api/upload.
  captionsUrl     String?
  textContent     String?
  durationSeconds Int?
  description     String?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  contributors User[] @relation("LessonContributors")

  resources   LessonResource[]
  progress    LessonProgress[]
  notes       LessonNote[]
  comments    LessonComment[]
  reactions   LessonReaction[]
  quiz        Quiz?
  viewCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  watchEvents WatchEvent[]

  videoRenditions LessonVideoRendition[]
  transcodeJobs   VideoTranscodeJob[]

  @@index([moduleId])
}

model LessonComment {
  id               String   @id @default(cuid())
  content          String
  // ids validados (participantes do curso) extraídos dos tokens @[Nome](id)
  // do content — evita re-parsear o texto sempre que precisamos de saber
  // quem já foi notificado por este comentário (ver PATCH de edição).
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   LessonComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  LessonComment[] @relation("CommentReplies")

  likes         CommentLike[]
  notifications Notification[]

  @@index([lessonId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  commentId String
  comment   LessonComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

// Comentários ao nível do CURSO (não da aula) — mostrados na página pública
// do curso (app/courses/[slug]/page.tsx), incluindo quando se chega lá a
// partir de uma revenda no marketplace. Mais simples que LessonComment: sem
// @menções/notificações (não há "participantes da aula" aqui, é uma página
// pública).
model CourseComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   CourseComment?  @relation("CourseCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CourseComment[] @relation("CourseCommentReplies")

  likes CourseCommentLike[]

  @@index([courseId])
  @@index([parentId])
}

model CourseCommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  commentId String
  comment   CourseComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model LessonReaction {
  id        String       @id @default(cuid())
  type      ReactionType
  createdAt DateTime     @default(now())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(MENTION)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Campos exclusivos de MENTION.
  commentId  String?
  comment    LessonComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  // Denormalizados na criação (não FKs) só para montar o link sem juntar
  // lesson→module→course a cada leitura da lista de notificações.
  courseSlug String?
  lessonId   String?

  // Campos exclusivos de RESALE_COMMISSION_CHANGE — denormalizados porque o
  // curso/listing podem mudar de preço outra vez depois desta notificação.
  resaleCourseTitle   String?
  resaleOldCommission Float?
  resaleNewCommission Float?
  resaleOldPrice      Float?
  resaleNewPrice      Float?

  @@index([recipientId, read])
}

// Comunidades (grupos, tipo WhatsApp+Reddit) — substitui o chat 1:1 que
// existia antes. Qualquer aluno/instrutor pode criar uma, outros juntam-se
// livremente (CommunityMember) sujeitos às regras do criador (Community.rules),
// e dentro debatem por texto ou anexo (imagem/vídeo/áudio/ficheiro — ver
// CommunityMessage). Hierarquia de moderação: OWNER (criador, único, nunca
// removível) > ADMIN (promovido pelo OWNER, remove/silencia MEMBER comuns,
// não mexe noutros ADMIN) > MEMBER.
enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

// Requisitos que o criador define para poder entrar — verificados no
// servidor tanto ao mostrar o ecrã de aceitação (ver lib/communityAccess.ts
// checkRequirements) como de novo no próprio POST /join (nunca confia só no
// que o cliente já mostrou).
enum CommunityRequirementType {
  PURCHASED_COURSE
  COMPLETED_COURSE
  MIN_ENROLLMENTS
  MIN_COMPLETED_COURSES
  MIN_REVIEWS
  INSTRUCTOR_ONLY
  STUDENT_ONLY
}

model CommunityRequirement {
  id          String                   @id @default(cuid())
  communityId String
  community   Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  type        CommunityRequirementType
  // Só usado por PURCHASED_COURSE/COMPLETED_COURSE.
  courseId    String?
  course      Course?                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Só usado pelos requisitos de mínimo (MIN_*).
  minValue    Int?
  createdAt   DateTime                 @default(now())

  @@index([communityId])
}

model Community {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // Regras definidas pelo criador — mostradas no ecrã de aceitação antes de
  // entrar (ver app/communities/[communityId]/page.tsx), a par dos
  // requisitos, que são verificados a sério (rules é só texto lido, não tem
  // verificação automática nenhuma).
  rules         String?
  // Avatar pequeno (tiles, cabeçalho do chat) — bannerUrl é a faixa grande no
  // topo da página da comunidade, mesmo padrão do perfil público.
  coverImageUrl String?
  bannerUrl     String?
  // Mesma taxonomia livre das categorias de curso (Fotografia, Negócios...)
  // — é o que agrupa a listagem de comunidades em filas horizontais por
  // categoria, tal como o catálogo agrupa cursos.
  category      String
  createdAt     DateTime @default(now())

  createdById String
  createdBy   User   @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Cascade)

  members      CommunityMember[]
  messages     CommunityMessage[]
  requirements CommunityRequirement[]
}

model CommunityMember {
  id          String        @id @default(cuid())
  communityId String
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("CommunityMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityMessage {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation("CommunityMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  content        String?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  // Apagar não remove a linha (ia partir a resposta de quem citou esta
  // mensagem) — só limpa o conteúdo e marca deleted, igual ao WhatsApp.
  deleted        Boolean @default(false)

  replyToId String?
  replyTo   CommunityMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   CommunityMessage[] @relation("MessageReplies")

  @@index([communityId, createdAt])
}

model LessonResource {
  id        String       @id @default(cuid())
  name      String
  url       String
  type      ResourceType
  sizeBytes Int
  createdAt DateTime     @default(now())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

enum TranscodeStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// Fila para o worker externo (ffmpeg, fora do Next.js/Vercel — sem binário
// ffmpeg nem tempo de execução para isso nas functions serverless). O
// worker faz poll de PENDING, marca PROCESSING, sobe as renditions e chama
// de volta a completar/falhar (ver app/api/worker/jobs).
model VideoTranscodeJob {
  id        String          @id @default(cuid())
  sourceUrl String
  status    TranscodeStatus @default(PENDING)
  error     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lessonId])
}

// Uma linha por resolução gerada pelo worker para uma aula. "quality" é o
// rótulo mostrado no seletor do player (ex. "1080p").
model LessonVideoRendition {
  id        String   @id @default(cuid())
  quality   String
  url       String
  width     Int
  height    Int
  sizeBytes Int
  createdAt DateTime @default(now())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, quality])
  @@index([lessonId])
}

model Enrollment {
  id          String    @id @default(cuid())
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  completed      Boolean   @default(false)
  completedAt    DateTime?
  watchedSeconds Int       @default(0)
  updatedAt      DateTime  @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

// Notas pessoais do aluno para uma aula específica — cada nota tem um
// título (auto-gerado das primeiras palavras se vazio) e conteúdo de texto.
// Mostradas numa lista estilo grid de cursos, clicáveis para editar.
model LessonNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([lessonId])
}

// Um ping por cada 5s de reprodução (ver /api/progress) — usado só para
// distribuição por hora do dia ("quando é que as pessoas veem aulas").
// Tempo total por aula/curso continua a vir de LessonProgress.watchedSeconds.
model WatchEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([createdAt])
}

model Quiz {
  id               String    @id @default(cuid())
  scope            QuizScope
  title            String
  // Só usado em scope MODULE — posição entre as aulas do mesmo módulo (vários
  // quizzes por módulo, cada um na sua posição, tal como uma aula).
  order            Int       @default(0)
  maxAttempts      Int?
  timeLimitMinutes Int?
  // Só usado em scope COURSE — horas de espera obrigatória antes de poder
  // repetir o quiz final (após esgotar tentativas ou voltar a tentar).
  retryAfterHours  Int?
  // Só usado em scope LESSON/MODULE — o quiz final (COURSE) mostra sempre o
  // countdown quando tem timeLimitMinutes; nos outros é opcional, ao critério
  // do instrutor.
  showCountdown    Boolean   @default(false)
  createdAt        DateTime  @default(now())

  lessonId String? @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Sem @unique: um módulo pode ter vários quizzes (ordenados por `order`,
  // intercalados com as aulas), ao contrário do quiz de aula/curso (1:1).
  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId String? @unique
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([moduleId])
}

model QuizQuestion {
  id    String @id @default(cuid())
  text  String
  order Int

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options QuizOption[]

  @@index([quizId])
}

model QuizOption {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model QuizAttempt {
  id           String   @id @default(cuid())
  scorePercent Int
  answers      Json
  createdAt    DateTime @default(now())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
}
